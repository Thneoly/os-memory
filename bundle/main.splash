let memories = []
let next_id = 1
let agent_state = nil
let agent_summary = ""
let export_note = ""

let MONTHS = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]

fn load(){
    if fs.exists("memories.json") {
        let v = fs.read("memories.json").parse_json()
        if v != nil {
            memories = v
            for i in memories.len() {
                let n = memories[i].id.to_f64()
                if n >= next_id { next_id = floor(n) + 1 }
            }
        }
    }
    ui.list.render()
}

fn save(){ fs.write("memories.json", memories.to_json()) }

fn add(){
    let text = ui.entry.text()
    if text == "" { return }
    memories.push({id: "" + next_id, source: "self", text: text, created: time_now()})
    next_id = next_id + 1
    ui.entry.set_text("")
    save()
    ui.list.render()
}

fn remove(i){
    let kept = []
    for j in memories.len() { if j != i { kept.push(memories[j]) } }
    memories = kept
    save()
    ui.list.render()
}

fn probe(){
    host.request("octos.session.history", {}, fn(r){
        if r.is_ok {
            agent_state = true
            agent_summary = "" + r.data.messages.len() + " messages with the assistant"
        } else {
            agent_state = false
            agent_summary = ""
        }
        ui.assistant.render()
        ui.chip.set_text(chip_text())
    })
}

fn chip_text(){
    if agent_state == true { return "assistant: on" }
    if agent_state == false { return "assistant: off" }
    return "assistant: …"
}

fn source_label(s){
    if s == "self" { return "MY MEMORY" }
    return "FROM " + s
}

fn date_str(ts){
    let t = local_time(ts)
    return MONTHS[t.month - 1] + " " + t.day
}

fn export_pinned(){
    let out = ""
    for i in memories.len() {
        let e = memories[i]
        out = out + "[" + e.source + "] " + e.text + " (" + date_str(e.created) + ")\n"
    }
    fs.write("export.txt", out)
    export_note = "Saved export.txt (" + memories.len() + " entries)"
    ui.export_note.set_text(export_note)
}

start_timeout(0.05, || { load() probe() })

let ink = #x1c1c1e
let secondary = #x8e8e93
let blue = #x007aff
SolidView{width: Fill height: Fill flow: Down padding: 16 spacing: 12 draw_bg.color: #xffffff
    View{width: Fill height: Fit flow: Right spacing: 8 align: Align{y: 0.5}
        Label{width: Fill text: "Memory" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 28}}
        chip := Label{text: chip_text() draw_text.color: secondary draw_text.text_style.font_size: 12}
    }
    View{width: Fill height: Fit flow: Right spacing: 8 align: Align{y: 0.5}
        entry := TextInput{width: Fill height: 40 empty_text: "Add a memory"
            draw_bg +: {color: #xf2f2f7 color_hover: #xf2f2f7 color_focus: #xf2f2f7 color_empty: #xf2f2f7 border_radius: 10.0}
            draw_text +: {color: ink color_hover: ink color_focus: ink color_empty: secondary color_empty_hover: secondary}}
        ButtonFlat{text: "Add" height: 40 padding: Inset{left: 18 right: 18} on_click: || add()
            draw_bg +: {border_radius: 20.0 color: blue color_hover: #x0a84ff color_down: #x0062cc border_size: 0.0}
            draw_text +: {color: #xffffff color_hover: #xffffff color_down: #xffffff}}
    }
    list := ScrollYView{width: Fill height: Fill flow: Down spacing: 8 on_render: || {
        if memories.len() == 0 {
            Label{text: "Nothing pinned yet. Add something above." draw_text.color: secondary}
        }
        for i in memories.len() {
            let j = memories.len() - 1 - i
            if j == memories.len() - 1 {
                Label{text: source_label(memories[j].source) draw_text.color: secondary draw_text.text_style.font_size: 11}
            } else {
                if memories[j].source != memories[j + 1].source {
                    Label{text: source_label(memories[j].source) draw_text.color: secondary draw_text.text_style.font_size: 11}
                }
            }
            GestureView{width: Fill height: Fit padding: 12 on_tap: |x, y| remove(j)
                Label{width: Fill text: memories[j].text draw_text.color: ink draw_text.text_style.font_size: 15}
                Label{width: Fill text: date_str(memories[j].created) draw_text.color: secondary draw_text.text_style.font_size: 11}
            }
            Hr{}
        }
    }}
    assistant := View{width: Fill height: Fit flow: Down spacing: 6 on_render: || {
        Label{text: "FROM THE ASSISTANT" draw_text.color: secondary draw_text.text_style.font_size: 11}
        if agent_state == nil {
            Label{text: "Checking…" draw_text.color: secondary draw_text.text_style.font_size: 13}
        }
        if agent_state == false {
            Label{text: "No assistant on this device — pinned memory still works." draw_text.color: secondary draw_text.text_style.font_size: 13}
        }
        if agent_state == true {
            Label{text: agent_summary draw_text.color: ink draw_text.text_style.font_size: 13}
        }
    }}
    View{width: Fill height: Fit flow: Right spacing: 8 align: Align{y: 0.5}
        ButtonFlat{text: "Export" height: 36 padding: Inset{left: 14 right: 14} on_click: || export_pinned()
            draw_bg +: {border_radius: 18.0 color: blue color_hover: #x0a84ff color_down: #x0062cc border_size: 0.0}
            draw_text +: {color: #xffffff color_hover: #xffffff color_down: #xffffff}}
        export_note := Label{width: Fill text: "" draw_text.color: secondary draw_text.text_style.font_size: 11}
    }
    Label{text: "Tap an entry to remove it. Pinned memory stays without an assistant." draw_text.color: secondary draw_text.text_style.font_size: 12}
}
